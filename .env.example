# ============================================
# HERE OPEN - Environment Variables
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/hereopen?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/hereopen?schema=public"

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"
OTP_SECRET="your-otp-secret-change-in-production"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ============================================
# API SERVER
# ============================================
API_PORT=3001
API_HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ============================================
# APP URLS
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_MOBILE_API_URL="http://localhost:3001"

# ============================================
# IOT / MQTT
# ============================================
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="hereopen-api"
IOT_DEVICE_SECRET_KEY="your-iot-device-secret"
IOT_COMMAND_TIMEOUT_MS=30000
IOT_HEARTBEAT_INTERVAL_MS=60000

# ============================================
# WEBSOCKET
# ============================================
WS_PORT=3001
WS_PATH="/ws"

# ============================================
# SMS / OTP PROVIDER
# ============================================
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="HEREOP"

# ============================================
# EMAIL
# ============================================
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@hereopen.in"

# ============================================
# PUSH NOTIFICATIONS
# ============================================
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# ============================================
# PAYMENTS (Future)
# ============================================
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ============================================
# STORAGE
# ============================================
STORAGE_PROVIDER="local"
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
LOCAL_STORAGE_PATH="./uploads"

# ============================================
# REDIS (Caching)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="debug"
LOG_FILE="logs/app.log"

# ============================================
# ADMIN
# ============================================
ADMIN_DEFAULT_EMAIL="admin@hereopen.in"
ADMIN_DEFAULT_PASSWORD="admin123"
